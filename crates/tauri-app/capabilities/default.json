{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "EchoMind 默认能力配置：授予主窗口所需的最小权限集（Tauri v2 ACL）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default"
  ]
}
