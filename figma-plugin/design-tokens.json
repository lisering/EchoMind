{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "EchoMind Design System v2.0 — 暗色主题",
  "surface": {
    "surface-0": { "$value": "#0A0A0B", "$type": "color", "description": "最暗背景（App 背景）" },
    "surface-1": { "$value": "#131316", "$type": "color", "description": "侧栏/面板背景" },
    "surface-2": { "$value": "#1C1C20", "$type": "color", "description": "消息气泡/卡片背景" },
    "surface-3": { "$value": "#26262C", "$type": "color", "description": "Tab 激活态/Hover 背景" },
    "surface-4": { "$value": "#303036", "$type": "color", "description": "Toggle OFF/禁用态背景" }
  },
  "border": {
    "border-subtle": { "$value": "#1F1F23", "$type": "color", "description": "最淡边框（侧栏分隔线）" },
    "border-default": { "$value": "#2A2A2E", "$type": "color", "description": "默认边框（输入框/卡片）" },
    "border-strong": { "$value": "#3A3A40", "$type": "color", "description": "强调边框（命令面板/Modal）" }
  },
  "text": {
    "text-primary": { "$value": "#F8FAFC", "$type": "color", "description": "主标题/高亮文本" },
    "text-secondary": { "$value": "#CBD5E1", "$type": "color", "description": "正文/对话内容" },
    "text-tertiary": { "$value": "#94A3B8", "$type": "color", "description": "辅助说明/标签" },
    "text-quaternary": { "$value": "#64748B", "$type": "color", "description": "占位符/禁用态" }
  },
  "accent": {
    "accent": { "$value": "#38BDF8", "$type": "color", "description": "主强调色（按钮/链接/激活态）" },
    "accent-hover": { "$value": "#0EA5E9", "$type": "color", "description": "Hover 态强调色" },
    "accent-subtle": { "$value": "rgba(56, 189, 248, 0.08)", "$type": "color", "description": "强调色淡背景" }
  },
  "semantic": {
    "success": { "$value": "#4ADE80", "$type": "color", "description": "成功/已索引状态" },
    "warning": { "$value": "#FBBF24", "$type": "color", "description": "警告/索引中状态" },
    "danger": { "$value": "#F87171", "$type": "color", "description": "错误/失败状态" },
    "info": { "$value": "#60A5FA", "$type": "color", "description": "信息提示" }
  },
  "radius": {
    "xs": { "$value": 4, "$type": "dimension", "description": "Badge/代码标签" },
    "sm": { "$value": 8, "$type": "dimension", "description": "输入框/按钮" },
    "md": { "$value": 12, "$type": "dimension", "description": "消息气泡/卡片" },
    "lg": { "$value": 16, "$type": "dimension", "description": "输入栏容器" },
    "xl": { "$value": 20, "$type": "dimension", "description": "预设卡片" },
    "2xl": { "$value": 24, "$type": "dimension", "description": "大容器/Modal" }
  },
  "spacing": {
    "0": { "$value": 0, "$type": "dimension" },
    "1": { "$value": 4, "$type": "dimension" },
    "2": { "$value": 8, "$type": "dimension" },
    "3": { "$value": 12, "$type": "dimension" },
    "4": { "$value": 16, "$type": "dimension" },
    "5": { "$value": 20, "$type": "dimension" },
    "6": { "$value": 24, "$type": "dimension" },
    "8": { "$value": 32, "$type": "dimension" },
    "10": { "$value": 40, "$type": "dimension" },
    "12": { "$value": 48, "$type": "dimension" }
  },
  "shadow": {
    "float": { "$value": { "x": 0, "y": 4, "blur": 12, "color": "rgba(0,0,0,0.15)" }, "$type": "shadow", "description": "浮动卡片阴影" },
    "pop": { "$value": { "x": 0, "y": 8, "blur": 24, "color": "rgba(0,0,0,0.2)" }, "$type": "shadow", "description": "弹出层阴影" },
    "modal": { "$value": { "x": 0, "y": 16, "blur": 48, "color": "rgba(0,0,0,0.25)" }, "$type": "shadow", "description": "Modal 大阴影" },
    "glow": { "$value": { "x": 0, "y": 0, "blur": 3, "color": "rgba(56,189,248,0.25)" }, "$type": "shadow", "description": "Focus 环光晕" }
  },
  "type": {
    "display-lg": { "$value": { "fontFamily": "Inter", "fontSize": 32, "fontWeight": 700, "lineHeight": 40 }, "$type": "typography", "description": "向导大标题" },
    "display-md": { "$value": { "fontFamily": "Inter", "fontSize": 28, "fontWeight": 700, "lineHeight": 36 }, "$type": "typography", "description": "Modal 标题" },
    "title-lg": { "$value": { "fontFamily": "Inter", "fontSize": 20, "fontWeight": 600, "lineHeight": 28 }, "$type": "typography", "description": "分区标题" },
    "title-md": { "$value": { "fontFamily": "Inter", "fontSize": 16, "fontWeight": 600, "lineHeight": 24 }, "$type": "typography", "description": "副标题" },
    "body-md": { "$value": { "fontFamily": "Inter", "fontSize": 14, "fontWeight": 400, "lineHeight": 22 }, "$type": "typography", "description": "正文/Messages" },
    "body-sm": { "$value": { "fontFamily": "Inter", "fontSize": 13, "fontWeight": 400, "lineHeight": 20 }, "$type": "typography", "description": "辅助正文" },
    "caption": { "$value": { "fontFamily": "Inter", "fontSize": 11, "fontWeight": 500, "lineHeight": 16 }, "$type": "typography", "description": "Badge/标注" },
    "overline": { "$value": { "fontFamily": "Inter", "fontSize": 10, "fontWeight": 600, "lineHeight": 14, "letterSpacing": 1 }, "$type": "typography", "description": "大写分区头" }
  }
}
